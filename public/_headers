# Static-asset headers (Cloudflare). These apply to the SPA, not to Worker
# /api/* responses (those set their own headers in code).
#
# CRITICAL for WebMCP: the API is only available in ORIGIN-ISOLATED documents,
# and the header `Origin-Agent-Cluster: ?0` DISABLES it. So the requirement is
# negative — we must NEVER emit that header. We do not add COOP/COEP either,
# since that is not required for origin isolation here and can break embedding.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  # Chrome WebMCP origin trial for deepblocker.ai (isSubdomain, so it also covers
  # trustwright.deepblocker.ai). Gives visitors in supporting Chrome a native WebMCP
  # host — no flag — so a real agent can drive Mode 1. Public value; expires
  # 2026-11-17. Self-hosters on another domain should replace or remove this.
  Origin-Trial: ArPV59qffe+oMX6UlHCgfgDSCLwgr4ziWj4kj67rgx4RNRE232Ppuu4jGwedPi4xu4dDdgegBJik4xnO0AWZ2AYAAABheyJvcmlnaW4iOiJodHRwczovL2RlZXBibG9ja2VyLmFpOjQ0MyIsImZlYXR1cmUiOiJXZWJNQ1AiLCJleHBpcnkiOjE3OTQ4NzM2MDAsImlzU3ViZG9tYWluIjp0cnVlfQ==

# Long-cache the fingerprinted assets; never cache the HTML shell.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
